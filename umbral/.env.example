# ---------------------------------------------------------------------------
# Umbral — variables de entorno. NUNCA subas un .env real al repositorio.
# Ninguna clave es obligatoria: la plataforma funciona al 100% sin proveedores
# externos (analizadores propios + agregador).
# ---------------------------------------------------------------------------

# --- Modo de ejecución -------------------------------------------------------
# development | production. En producción los adaptadores comerciales son los
# únicos autorizados a salir a la red (server-side).
NODE_ENV=development

# --- Proveedores comerciales (todos desactivados por defecto) ----------------
# Autorización explícita del operador para enviar texto a terceros.
UMBRAL_ENABLE_EXTERNAL=false

# Sapling (https://sapling.ai/docs/api/detector/) — clave de 32 caracteres.
SAPLING_API_KEY=
# Fuerza retención cero en Sapling (recomendado, por defecto true).
SAPLING_ZERO_RETENTION=true
# Presupuesto máximo de caracteres que Umbral enviará a Sapling. 0 = sin envío.
SAPLING_CHAR_BUDGET=0
# Versión del detector a fijar. Vacío = enrutado automático por idioma.
SAPLING_MODEL_VERSION=

# GPTZero (https://docs.gptzero.me/) — adaptador listo, desactivado.
GPTZERO_API_KEY=
GPTZERO_CHAR_BUDGET=0

# --- Límites defensivos ------------------------------------------------------
# Longitud máxima aceptada por petición (caracteres).
UMBRAL_MAX_INPUT_CHARS=30000
# Peticiones por minuto y por instancia (rate limiting en memoria).
UMBRAL_RATE_LIMIT_PER_MIN=30
# Timeout por motor (ms).
UMBRAL_ENGINE_TIMEOUT_MS=8000
# Timeout por proveedor externo (ms).
UMBRAL_PROVIDER_TIMEOUT_MS=12000

# --- Simulación (SOLO pruebas de interfaz) ----------------------------------
# Si es true, expone respuestas de proveedores simuladas y marcadas
# simulated:true. Nunca se suman al agregador de un análisis real.
UMBRAL_ALLOW_MOCK=false
