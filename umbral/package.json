{
  "name": "umbral",
  "version": "0.1.0",
  "private": true,
  "description": "Umbral — plataforma de analisis multimodelo de texto (arquitectura hibrida, prioridad espanol)",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "calibrate": "node scripts/evaluate-aggregator.mjs",
    "docs:engines": "python3 scripts/gen-engine-docs.py",
    "verify": "bash scripts/verify.sh",
    "e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.2",
    "vitest": "5.0.5",
    "jsdom": "30.1.3",
    "@playwright/test": "1.55.0"
  }
}
